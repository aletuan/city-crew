# Copy to .env.local for local dev. Both values are public by design
# (RLS is the security boundary) — find them in Supabase → Settings → API.
VITE_SUPABASE_URL=https://amdvitzpogaejzzqroco.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_VVol99Jqs0QYzeVrmOawlw_ZpXqcv7B

# The Data Desk's basemap. Unlike the two values above, this one is NOT
# committed: there is no RLS behind it, and the only thing standing between
# the key and someone else's bill is an HTTP-referrer restriction — which a
# single curl can forge. The key ships inside the public Pages bundle either
# way; there is no need to leave a second copy in the repo for scrapers.
#
# Get it from Google Cloud Console → Credentials. It needs the Maps
# JavaScript API enabled, a referrer allowlist covering http://localhost and
# https://aletuan.github.io/*, and a daily quota cap. Leave it unset and the
# desk still works — Coverage draws its bubbles on dark ground and the
# Fact-check panel shows coordinates, just without a map.
VITE_GOOGLE_MAPS_KEY=
