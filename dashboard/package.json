{
  "name": "citycrew-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-test-module-mocks --test",
    "coverage": "c8 --all --src src --include 'src/**/*.js' --exclude src/categories.js --exclude src/vibes.js --exclude src/lib/supabase.js --per-file --check-coverage --lines 83 --functions 51 --branches 0 --statements 0 --reporter text node --experimental-test-module-mocks --test",
    "preview": "vite preview",
    "test:ui": "vitest run",
    "coverage:ui": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
