diff --git a/app/.maestro/07-sign-up-delete.yaml b/app/.maestro/07-sign-up-delete.yaml
new file mode 100644
index 0000000..a250004
--- /dev/null
+++ b/app/.maestro/07-sign-up-delete.yaml
@@ -0,0 +1,115 @@
+# Sign up as a brand-new, throwaway account, then delete it from inside
+# the app. The App Store's in-app account-deletion requirement (5.1.1(v))
+# has no flow covering it otherwise, and vitest cannot reach it either —
+# it needs the real SignUpScreen wizard, a real Supabase account, and the
+# `delete-account` edge function actually running.
+#
+# The account is disposable by construction: Maestro's own
+# `inputRandomPersonName` / `inputRandomEmail` give it a name and address
+# nobody chose and nothing else here reuses, created in this run and
+# deleted before it ends. It never touches the dedicated ${TEST_EMAIL}
+# account the other signed-in flows share, and needs no setup by hand.
+#
+# Assumes email confirmation is off (`mailer_autoconfirm` — see
+# lib/signup.ts, "this project's configuration today"), so `signUp` lands
+# straight on the taste picker with a session already made. If that is
+# ever turned on, sign-up stops at "Check your email" instead, and this
+# flow has no inbox to read a code from — it fails there on a timeout
+# rather than doing something wrong quietly.
+#
+# If a run dies after the account exists and before it is deleted, it is
+# an orphan: a Supabase-side sweep for it is still on the list (see
+# GUIDELINES.md).
+appId: host.exp.Exponent
+env:
+  EXPO_URL: exp://127.0.0.1:8081
+---
+- runFlow: common/start.yaml
+- runFlow: common/ensure-signed-out.yaml
+- tapOn:
+    id: "profile-sign-in"
+- extendedWaitUntil:
+    visible:
+      id: "signin-email"
+    timeout: 15000
+- tapOn:
+    id: "signin-switch-signup"
+- extendedWaitUntil:
+    visible:
+      id: "signup-name"
+    timeout: 15000
+
+# The form. The username is left alone: it is suggested from the name,
+# and a collision falls back to a server-generated handle rather than
+# failing the account into existence (see `handle_new_user`).
+- tapOn:
+    id: "signup-name"
+- inputRandomPersonName
+- tapOn:
+    id: "signup-email"
+- inputRandomEmail
+- tapOn:
+    id: "signup-password"
+- inputText: "Maestro-smoke-1"
+- tapOn:
+    id: "signup-confirm"
+- inputText: "Maestro-smoke-1"
+- hideKeyboard
+- tapOn:
+    id: "signup-submit"
+
+# Taste picker: skip it, the same real answer a reader who has not
+# decided yet gets to give. TastePicker's grid can push "Skip for now"
+# below the fold on a shorter simulator, and it sits at the very foot of
+# the page under the Continue button — rule 9, not a plain wait.
+- scrollUntilVisible:
+    element:
+      id: "signup-taste-skip"
+    direction: DOWN
+    timeout: 15000
+- scroll
+- tapOn:
+    id: "signup-taste-skip"
+
+# Welcome — the account exists and is signed in. Continuing leaves the
+# sign-up stack and lands back on Profile, now rendering signed in. Same
+# foot-of-page treatment: the plane art alone is 250pt tall, tight on an
+# iPhone SE-sized simulator once the greeting and lede sit under it too.
+- scrollUntilVisible:
+    element:
+      id: "signup-welcome-continue"
+    direction: DOWN
+    timeout: 20000
+- scroll
+- tapOn:
+    id: "signup-welcome-continue"
+
+# Delete it, from the same screen the persistent account's owner would
+# use — see DeleteAccountScreen.tsx for why this is one screen and one
+# button rather than a second confirmation. Reached via a mid-page tap on
+# Profile, hence `centerElement` on this first hop only; both stops on
+# DeleteAccountScreen itself are the two-card page's own foot and follow
+# rule 9 instead.
+- scrollUntilVisible:
+    element:
+      id: "profile-delete-account"
+    direction: DOWN
+    centerElement: true
+    timeout: 20000
+- tapOn:
+    id: "profile-delete-account"
+- scrollUntilVisible:
+    element:
+      id: "delete-account-confirm"
+    direction: DOWN
+    timeout: 15000
+- scroll
+- tapOn:
+    id: "delete-account-confirm"
+
+# The account and its session are gone; Profile falls back to the guest
+# view on its own, with no separate sign-out to do.
+- extendedWaitUntil:
+    visible:
+      id: "profile-sign-in"
+    timeout: 20000
