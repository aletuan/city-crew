  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:db": "f=src/lib/database.types.ts && { sed -n '1,/^export type Json/p' $f | sed '$d'; npx -y supabase@2 gen types typescript --project-id amdvitzpogaejzzqroco --schema public; } > $f.new && mv $f.new $f",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "legal:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal-html.mts",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test:tz": "TEST_TZ=America/New_York vitest run",
    "coverage": "vitest run --coverage",
    "smoke:ios": "maestro test .maestro"
  },
  "private": true
