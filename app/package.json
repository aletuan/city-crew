{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.7",
    "@supabase/supabase-js": "^2.112.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.6",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:db": "f=src/lib/database.types.ts && { sed -n '1,/^export type Json/p' $f | sed '$d'; npx -y supabase@2 gen types typescript --project-id amdvitzpogaejzzqroco --schema public; } > $f.new && mv $f.new $f",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "legal:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal-html.mts",
    "hant": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/hant-write.mts",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test:tz": "TEST_TZ=America/New_York vitest run",
    "coverage": "vitest run --coverage",
    "smoke:ios": "bash .maestro/smoke.sh"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-image-manipulator"
      ]
    }
  }
}
