{
  "expo": {
    "name": "City Crew",
    "slug": "citycrew",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0910",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "City Crew uses your location once to pick the nearest city for you.",
        "NSPhotoLibraryUsageDescription": "City Crew needs your photo library so you can pick a profile photo.",
        "NSCameraUsageDescription": "City Crew needs the camera so you can take a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.aletuan.citycrew"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.aletuan.citycrew"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "City Crew uses your location once to pick the nearest city for you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "City Crew needs your photo library so you can pick a profile photo.",
          "cameraPermission": "City Crew needs the camera so you can take a profile photo."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "updates": {
      "url": "https://u.expo.dev/b151a921-bb81-4cb2-83b8-6ab3803fbc6f"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "b151a921-bb81-4cb2-83b8-6ab3803fbc6f"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0910"
    }
  }
}
