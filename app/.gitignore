# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Coverage output — regenerated by `npm run coverage`.
coverage/

# Python bytecode — `scripts/map-pins.py` is the only Python here, and it
# leaves this behind whenever it is imported rather than run.
__pycache__/
