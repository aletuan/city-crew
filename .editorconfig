# Editor defaults, so a file does not change shape depending on who opened
# it. Deliberately the smallest set that every editor honours without a
# plugin — the repository has no repo-wide formatter run behind it (see
# .prettierrc.json for why), and these four rules are the ones a stray
# editor default would otherwise churn into every diff.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown uses trailing double-space as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 2
